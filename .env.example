# ---- Supabase ----
# Project URL  : dashboard -> Connect button (top bar)
# Both keys    : dashboard -> Project Settings -> API Keys  (NOT the "Legacy" tab)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---- AI providers ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Model ids. Change here, never in code ----
CLAUDE_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5.6-sol

# ---- Reasoning effort: low | medium | high | xhigh | max ----
# Leave CLAUDE_EFFORT empty to use Claude's own default (high).
CLAUDE_EFFORT=
OPENAI_EFFORT=medium

# ---- Email (needed from Phase 2) ----
RESEND_API_KEY=

# ---- Where this app is reachable. Used to build onboarding links. ----
# Locally this is http://localhost:3000. In Vercel it must be the deployed
# origin, or every onboarding link a client receives points at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Phase 2 test operator (optional, local only) ----
# Used by scripts/check-client-visibility.ts to prove what the database will
# actually return when a policy hides rows. Ask the lead for the values.
TEST_OPERATOR_EMAIL=
TEST_OPERATOR_PASSWORD=
